# Copy to .env and fill in. .env is gitignored — never commit it.
# Secrets are NOT stored here directly: this file holds *paths* to key files
# (under secrets/, also gitignored) and non-secret config.
#
# Exact venue auth field names, endpoints and schemes are NOT guessed here.
# Verify each against the venue docs and record it in docs/venue-notes.md
# before wiring it up.

# --- Run identity ---
RUN_ID=

# --- Kalshi (verify auth scheme + endpoints in docs/venue-notes.md) ---
# KALSHI_API_BASE=
# KALSHI_WS_URL=
# KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi_private_key.pem

# --- Polymarket US only (docs.polymarket.us). International Polymarket is out of scope. ---
# POLYMARKET_US_API_BASE=
# POLYMARKET_US_WS_URL=
POLYMARKET_US_KEY_PATH=secrets/polymarket_us_key

# --- Postgres (binds to 127.0.0.1 only; SSH tunnel on the VM) ---
DATABASE_URL=postgresql+asyncpg://arb:arb@127.0.0.1:5432/arb

# --- Observability (127.0.0.1 only) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
