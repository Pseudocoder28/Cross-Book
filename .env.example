# Copy to .env and fill in. .env is gitignored — never commit it.
# Secrets are NOT stored here directly: this file holds *paths* to key files
# (under secrets/, also gitignored) and non-secret config.
#
# Endpoints below are doc-verified (see docs/venue-notes.md, 2026-09-13).
# Defaults live in src/arb/config.py; set a variable here only to override.

# --- Run identity (optional; autogenerated when empty) ---
RUN_ID=

# --- Kalshi ---
# WS requires API-key auth on the handshake even for market data.
# Demo hosts (if starting there): https://external-api.demo.kalshi.co/trade-api/v2
#                                 wss://external-api-ws.demo.kalshi.co/trade-api/ws/v2
KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi_private_key.pem

# --- Polymarket US only (docs.polymarket.us). International Polymarket is out of scope. ---
# Gateway REST is public; the markets WS requires Ed25519 API-key auth on the
# handshake. Secret key file holds the base64 secret from polymarket.us/developer.
POLYMARKET_US_GATEWAY_BASE=https://gateway.polymarket.us
POLYMARKET_US_API_BASE=https://api.polymarket.us
POLYMARKET_US_WS_URL=wss://api.polymarket.us/v1/ws/markets
POLYMARKET_US_ACCESS_KEY=
POLYMARKET_US_SECRET_KEY_PATH=secrets/polymarket_us_secret

# --- Postgres (binds to 127.0.0.1 only; SSH tunnel on the VM) ---
DATABASE_URL=postgresql+asyncpg://arb:arb@127.0.0.1:5432/arb

# --- Clock ---
# Time server `arb doctor` measures the local clock against, over SNTP
# (needs outbound UDP 123). A local clock running behind the venue's makes
# every one-way latency reading negative -- see docs/ops.md.
# NTP_SERVER=pool.ntp.org

# --- Books / recorder (defaults in src/arb/config.py) ---
# BOOK_STALENESS_LIMIT_MS=5000
# RECORDER_QUEUE_MAX=100000
# RECORDER_BATCH_MAX=500

# --- Terminal UI control plane ---
# The UI has no authentication and its /control page drives a trading process,
# so binding off loopback is an explicit opt-in. docker-compose sets this for
# the app service, which binds 0.0.0.0 inside its own network.
# ARB_ALLOW_REMOTE_BIND=1
# Serve every screen but refuse every control — what to use when showing the
# terminal to someone over a tunnel.
# UI_READ_ONLY=1
# Extra Host / Origin values the guard accepts, comma separated. Loopback is
# always allowed; add to these only if you front the UI with something.
# UI_ALLOWED_HOSTS=
# UI_ALLOWED_ORIGINS=
