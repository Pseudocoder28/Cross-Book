          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (venue, reason) (rate(arb_book_invalidations_total[$__rate_interval]))",
          "legendFormat": "{{venue}} {{reason}}",
